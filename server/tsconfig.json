{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node",
      "express"
    ],
    "noImplicitAny": true
  },
  "include": [
    "server.ts",
    "src/**/*.ts"
  ]
}
